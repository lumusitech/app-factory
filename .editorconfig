# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Los saltos de línea en Markdown usan espacios finales.
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
