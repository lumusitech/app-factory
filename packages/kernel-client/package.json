{
  "name": "@kernel/client",
  "version": "0.1.0",
  "private": true,
  "description": "Cliente offline del kernel: cola, caché GET, flush y connectivity, parametrizados por puertos (sin dominio adentro).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kernel/contracts": "workspace:*",
    "@kernel/domain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
