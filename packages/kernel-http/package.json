{
  "name": "@kernel/http",
  "version": "0.1.0",
  "private": true,
  "description": "Adaptador de borde del kernel: Fastify + Zod, envelope, errores, alcance e idempotencia.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.2",
    "@kernel/contracts": "workspace:*",
    "@kernel/domain": "workspace:*",
    "@kernel/scope": "workspace:*",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@kernel/persistence": "workspace:*",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}